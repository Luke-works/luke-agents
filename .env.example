# Copy to .env for local dev:  cp .env.example .env
#
# Default brain = Groq (free, email signup): https://console.groq.com/keys
# Production (Render): set GROQ_API_KEY in the dashboard.
# Local dev: set GROQ_API_KEY here, OR leave all blank and run Ollama locally
#            (ollama pull qwen2.5:7b) — the app falls back to it.

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI brain — GPT-5 nano (cheap/fast). Set the key, then AGENTS_BRAIN=openai to
# use it even when GROQ_API_KEY is also set (otherwise Groq wins by default).
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-nano            # or gpt-5.4-nano for the newer snapshot
# OPENAI_REASONING_EFFORT=           # leave blank for nano (it 400s on this); e.g. "low" for larger gpt-5
# AGENTS_BRAIN=openai                # force a brain: groq | openai | gemini | ollama

# Alternatives (optional):
# GEMINI_API_KEY=        # blocked for managed/Workspace domains
# GEMINI_MODEL=gemini-2.0-flash
OLLAMA_MODEL=qwen2.5:7b

# Sentiment agent (LukeSense). High-volume + simple, so it runs on a cheaper
# model than the rest of the fleet:
#  - On Groq (the default brain) it uses SENTIMENT_GROQ_MODEL instead of GROQ_MODEL.
#  - SENTIMENT_MODEL pins a specific model for WHICHEVER brain is active (overrides
#    the Groq default above). Leave blank to use each brain's configured default.
#  - SENTIMENT_BATCH_MAX caps how many texts POST /agents/sentiment/batch accepts
#    in one (single) LLM call.
#  - SENTIMENT_DOC_CHUNK_CHARS sets the per-section size when /agents/sentiment/intake
#    chunks a long document (kind="document"); sections are scored then rolled up.
# SENTIMENT_GROQ_MODEL=llama-3.1-8b-instant
# SENTIMENT_MODEL=
# SENTIMENT_BATCH_MAX=50
# SENTIMENT_DOC_CHUNK_CHARS=2000

# Lock browser CORS to specific origins in prod (comma-separated). Default "*".
# AGENTS_CORS=https://app.example.com,https://qa.example.com

# Production hardening. Set AGENTS_ENV=production and the app REFUSES to start
# unless the service is locked down: AGENTS_API_KEY set (callers send X-Agents-Key),
# AGENTS_CORS not "*", and AGENTS_REQUIRE_TENANT=true (behind the gateway). Leave
# AGENTS_ENV unset for local dev (the browser-direct, default-open flow).
# AGENTS_ENV=production
# AGENTS_API_KEY=<random-strong-key>
# AGENTS_REQUIRE_TENANT=true

# Per-caller rate limit (per agent). Defaults: 200 actions / 3h.
# RATE_LIMIT_MAX=200
# RATE_LIMIT_WINDOW_SECONDS=10800

# Transcript store (chat retention for fine-tuning).
#  - DATABASE_URL set   -> Postgres; tables created in the AGENTS_DB_SCHEMA schema.
#  - DATABASE_URL unset  -> append-only JSONL under TRANSCRIPTS_DIR (LOCAL DEV ONLY;
#                           Render's disk is ephemeral, so prod needs Postgres).
#  - TRANSCRIPTS_ENABLED=false -> record nothing.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require
AGENTS_DB_SCHEMA=luke_agents
# TRANSCRIPTS_DIR=data/transcripts
# TRANSCRIPTS_ENABLED=true

# Retention / PII / GDPR (#29) — see docs/DATA_HANDLING.md.
#  - AGENTS_RETENTION_DAYS: purge turns older than N days. Unset / 0 = keep forever.
#    Enforce by running `python -m luke_agents.tools.retention purge` on a schedule.
#  - AGENTS_REDACT_PII: best-effort scrub emails/phones/SSNs from stored content.
#  - Right-to-erasure: `python -m luke_agents.tools.retention erase-user --user-id …`
#  - consent=false turns are stored MINIMALLY (metadata only, no message/output content).
#  - AGENTS_EXPORT_AUDIT_LOG: JSONL path where fine-tune exports are audited (who/when/scope).
# AGENTS_RETENTION_DAYS=90
# AGENTS_REDACT_PII=false
# AGENTS_EXPORT_AUDIT_LOG=data/export_audit.jsonl
