# Copy to .env for local dev:  cp .env.example .env
#
# Default brain = Groq (free, email signup): https://console.groq.com/keys
# Production (Render): set GROQ_API_KEY in the dashboard.
# Local dev: set GROQ_API_KEY here, OR leave all blank and run Ollama locally
#            (ollama pull qwen2.5:7b) — the app falls back to it.

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI brain — GPT-5 nano (cheap/fast). Set the key, then AGENTS_BRAIN=openai to
# use it even when GROQ_API_KEY is also set (otherwise Groq wins by default).
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-nano            # or gpt-5.4-nano for the newer snapshot
# OPENAI_REASONING_EFFORT=           # leave blank for nano (it 400s on this); e.g. "low" for larger gpt-5
# AGENTS_BRAIN=openai                # force a brain: groq | openai | gemini | ollama

# Alternatives (optional):
# GEMINI_API_KEY=        # blocked for managed/Workspace domains
# GEMINI_MODEL=gemini-2.0-flash
OLLAMA_MODEL=qwen2.5:7b

# Lock browser CORS to specific origins in prod (comma-separated). Default "*".
# AGENTS_CORS=https://app.example.com,https://qa.example.com

# Per-caller rate limit (per agent). Defaults: 200 actions / 3h.
# RATE_LIMIT_MAX=200
# RATE_LIMIT_WINDOW_SECONDS=10800

# Transcript store (chat retention for fine-tuning).
#  - DATABASE_URL set   -> Postgres; tables created in the AGENTS_DB_SCHEMA schema.
#  - DATABASE_URL unset  -> append-only JSONL under TRANSCRIPTS_DIR (LOCAL DEV ONLY;
#                           Render's disk is ephemeral, so prod needs Postgres).
#  - TRANSCRIPTS_ENABLED=false -> record nothing.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require
AGENTS_DB_SCHEMA=luke_agents
# TRANSCRIPTS_DIR=data/transcripts
# TRANSCRIPTS_ENABLED=true
